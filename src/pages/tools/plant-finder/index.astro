---
import Base from '../../../layouts/Base.astro'; import {plants} from '../../../data/plants';
---
<Base title="Plant Finder — Garden"><article class="article"><p class="eyebrow">Tool / Plant Finder</p><h1>당신의 환경에 맞는 식물</h1><p>완벽한 정답이 아니라 현재 조건에 잘 맞을 가능성이 높은 후보를 찾습니다.</p><form id="finder"><label>실내 광량<select name="light"><option value="bright">밝음</option><option value="medium">중간</option><option value="low">낮음</option></select></label><label>물주기 빈도<select name="water"><option value="often">자주 확인</option><option value="sometimes">가끔 확인</option><option value="rare">자주 못 함</option></select></label><label>원하는 난이도<select name="difficulty"><option value="easy">쉬움</option><option value="any">상관없음</option></select></label><button>후보 보기</button></form><div id="result" class="result" aria-live="polite">조건을 선택하면 후보와 이유가 표시됩니다.</div></article></Base>
<script define:vars={{plants}}>
const form=document.querySelector('#finder'), result=document.querySelector('#result'); form?.addEventListener('submit',e=>{e.preventDefault();const d=new FormData(form);const ranked=plants.map(p=>{let score=0,reasons=[];if(d.get('difficulty')==='any'||p.difficulty==='쉬움'){score++;reasons.push('관리 난이도 조건에 가까움')}if(d.get('light')==='low'&&p.light.includes('낮은')){score+=2;reasons.push('낮은 빛에도 적응 가능')}if(d.get('water')==='rare'&&p.watering.includes('거의')){score+=2;reasons.push('흙이 마른 뒤 물을 주는 편')}if(d.get('light')==='bright'&&p.light.includes('밝은')){score++;reasons.push('밝은 간접광을 활용하기 좋음')}return {p,score,reasons}}).sort((a,b)=>b.score-a.score).slice(0,3);result.innerHTML='<h2>현재 조건에 맞을 가능성이 높은 후보</h2>'+ranked.map(({p,reasons})=>`<p><b><a href="/plants/${p.slug}/">${p.nameKo}</a></b><br>${(reasons.length?reasons:['환경 정보를 더 관찰해 보세요']).join(' · ')}</p>`).join('')});
</script>
